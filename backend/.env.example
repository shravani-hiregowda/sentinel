# Server Configuration
PORT=5000
NODE_ENV=development

# Database (MongoDB)
# Local fallback: mongodb://127.0.0.1:27017/sentinel
MONGO_URI=mongodb://127.0.0.1:27017/sentinel

# Redis Configuration (Required for BullMQ SLA Escalation Queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=your_super_strong_jwt_secret_here
JWT_EXPIRES_IN=7d

# CORS Configuration (Comma-separated allowed origins in production)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Observability & Operations
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Twilio SMS Notifications (Optional / Mock default)
TWILIO_ACCOUNT_SID=ACmock_account_sid
TWILIO_AUTH_TOKEN=mock_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# IBM watsonx AI Operations Assistant (Phase 7 - Optional)
# Get credentials from IBM Cloud Resource List -> watsonx.ai instance
IBM_WATSONX_API_KEY=your_ibm_cloud_iam_api_key_here
IBM_WATSONX_PROJECT_ID=your_watsonx_project_guid_here
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
IBM_WATSONX_API_VERSION=2024-05-31
AI_RATE_LIMIT_MAX=30
