# Sentinel Production Environment Configuration Example
PORT=5000
NODE_ENV=production

# Production Database (Use authenticated replica set or Atlas connection string)
MONGO_URI=mongodb://user:STRONG_PASSWORD_HERE@mongodb-primary:27017,mongodb-secondary:27017/sentinel?replicaSet=rs0&authSource=admin&ssl=true
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=10

# Production Redis (Clustered or Sentinel-managed Redis with AUTH)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=STRONG_REDIS_PASSWORD_HERE

# Authentication & Security (MANDATORY: 64-character high entropy random secret)
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_CRYPTOGRAPHICALLY_SECURE_RANDOM_SECRET_STRING
JWT_EXPIRES_IN=7d

# CORS Configuration (Strict comma-separated origins)
CLIENT_ORIGIN=https://app.sentinelgov.io,https://dashboard.sentinelgov.io

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=20

# Logging & Shutdown
LOG_LEVEL=info
SHUTDOWN_TIMEOUT_MS=10000

# Twilio SMS Notifications (Production credentials from AWS Secrets Manager / Vault)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# IBM watsonx AI Operations Assistant (Phase 7 - Production)
# Configure via secret manager (AWS Secrets Manager / Vault / Render Secret)
IBM_WATSONX_API_KEY=
IBM_WATSONX_PROJECT_ID=
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
IBM_WATSONX_API_VERSION=2024-05-31
AI_RATE_LIMIT_MAX=30
