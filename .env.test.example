# Sentinel Test Environment Configuration Example
PORT=5001
NODE_ENV=test

# Isolated Test Database
MONGO_URI=mongodb://127.0.0.1:27017/sentinel_test

# Isolated Test Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=test_deterministic_jwt_secret_32_characters_minimum
JWT_EXPIRES_IN=1d

# CORS
CLIENT_ORIGIN=http://localhost:3000

# Rate Limiting (High limits for test execution)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10000
AUTH_RATE_LIMIT_MAX=1000

# Logging & Shutdown
LOG_LEVEL=warn
SHUTDOWN_TIMEOUT_MS=2000

# Twilio (Disabled in tests)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# IBM watsonx AI Operations Assistant (Test Mock Defaults)
IBM_WATSONX_API_KEY=mock_watsonx_api_key_for_testing
IBM_WATSONX_PROJECT_ID=mock_project_id_12345
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
IBM_WATSONX_API_VERSION=2024-05-31
AI_RATE_LIMIT_MAX=1000
